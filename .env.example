# Auth
AUTH_SECRET=troque-em-producao

# SQLite
DATABASE_URL=./data/predizza.sqlite

# OpenAI opcional (triagem; sem chave usa heurística)
# OPENAI_API_KEY=

# ── Evolution API (WhatsApp) ─────────────────────────────────
# Suba com: docker compose up -d
EVOLUTION_API_URL=http://localhost:8085
EVOLUTION_API_KEY=predizza-evolution-key
EVOLUTION_INSTANCE=palmeiras
# Slug do edifício Predizza (seed: palmeiras)
EVOLUTION_BUILDING_SLUG=palmeiras
# Opcional: mapa instância → slug  {"outra-instancia":"palmeiras"}
# EVOLUTION_INSTANCE_MAP={}
# Só processa se mensagem citar Predizza (recomendado em grupos)
EVOLUTION_REQUIRE_MENTION=1
# Segredo do webhook (header x-webhook-secret)
EVOLUTION_WEBHOOK_SECRET=predizza-webhook-secret
# Número para envio do resumo semanal (opcional)
# EVOLUTION_DIGEST_JID=5511999999999

# API REST Predizza (header x-api-key)
# PREDIZZA_API_KEY=dev-api-key
